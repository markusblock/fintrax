<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.fintrax.ui.controller.ActivityLogController" styleClass="view-root">
    <top>
        <VBox styleClass="view-header">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%view.activityLog" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <VBox spacing="10" styleClass="filter-panel">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="actionFilter" promptText="%filter.action" accessibleText="%filter.action"/>
                    <ComboBox fx:id="entityTypeFilter" promptText="%filter.entityType" accessibleText="%filter.entityType"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="detailsButton" text="%button.viewDetails" onAction="#onViewDetails"
                            styleClass="button-outlined" disable="true"/>
                </HBox>
                <GridPane hgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="34" hgrow="ALWAYS" minWidth="100"/>
                        <ColumnConstraints percentWidth="33" hgrow="ALWAYS" minWidth="100"/>
                        <ColumnConstraints percentWidth="33" hgrow="ALWAYS" minWidth="100"/>
                    </columnConstraints>
                    <ComboBox fx:id="datePresetFilter" promptText="%filter.datePreset"
                              accessibleText="%filter.datePreset" maxWidth="Infinity"
                              GridPane.columnIndex="0"/>
                    <DatePicker fx:id="fromDateFilter" promptText="%filter.fromDate"
                                accessibleText="%filter.fromDate" maxWidth="Infinity"
                                GridPane.columnIndex="1"/>
                    <DatePicker fx:id="toDateFilter" promptText="%filter.toDate"
                                accessibleText="%filter.toDate" maxWidth="Infinity"
                                GridPane.columnIndex="2"/>
                </GridPane>
            </VBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="logTable" styleClass="dense">
            <columns>
                <TableColumn fx:id="timestampColumn" text="%col.timestamp" prefWidth="160"/>
                <TableColumn fx:id="actionColumn" text="%col.action" prefWidth="80"/>
                <TableColumn fx:id="entityTypeColumn" text="%col.entityType" prefWidth="100"/>
                <TableColumn fx:id="entityIdColumn" text="%col.entityId" prefWidth="60"/>
                <TableColumn fx:id="descriptionColumn" text="%col.description" prefWidth="400"/>
                <TableColumn minWidth="17" prefWidth="17" maxWidth="17"
                             resizable="false" sortable="false" reorderable="false">
                    <graphic>
                        <MenuButton fx:id="columnMenuButton" accessibleText="%button.columns"
                                    styleClass="column-menu-button"/>
                    </graphic>
                </TableColumn>
            </columns>
        </TableView>
    </center>
</BorderPane>
