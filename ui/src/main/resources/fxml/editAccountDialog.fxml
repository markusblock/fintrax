<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.fintrax.ui.controller.EditAccountDialogController"
      styleClass="dialog-content">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="%dialog.editAccount.title" styleClass="dialog-title"/>
    <Label text="%dialog.editAccount.subtitle" styleClass="dialog-subtitle" wrapText="true"/>

    <StackPane VBox.vgrow="ALWAYS">
        <ScrollPane fx:id="connectionPage" fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="520">
            <content>
                <VBox spacing="14">
                <VBox styleClass="editor-panel" spacing="10">
                    <Label text="%label.bankConnection" styleClass="section-title"/>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="140" halignment="RIGHT"/>
                            <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                        </columnConstraints>
                        <Label text="%label.bankName" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="bankNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="%label.blz" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="bankCodeField" editable="false" styleClass="read-only-field"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="%label.bic" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="bicField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="%label.fintsUserId" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="fintsUserIdField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="%label.fintsCustomerId" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="fintsCustomerIdField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label text="%label.pinForConnection" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <PasswordField fx:id="passwordField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        <Label text="%label.fintsServerUrl" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="6" GridPane.columnIndex="1">
                            <TextField fx:id="fintsServerUrlField" HBox.hgrow="ALWAYS"/>
                            <Button text="%button.findFinTsServer" onAction="#onFindFinTsServer"
                                    styleClass="button-outlined"/>
                        </HBox>
                        <Label text="%label.bankComment" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextField fx:id="bankCommentField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Label fx:id="fintsServerStatusLabel" text="%message.fints.lookupHint"
                           wrapText="true" styleClass="help-text"/>
                    <Label text="%message.bank.sharedEdit" wrapText="true" styleClass="help-text"/>
                    <Label text="%message.fints.pinNotStored" wrapText="true" styleClass="help-text"/>
                </VBox>

                <VBox styleClass="editor-panel" spacing="10">
                    <Label text="%label.accountDetails" styleClass="section-title"/>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="140" halignment="RIGHT"/>
                            <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                        </columnConstraints>
                        <Label text="%label.iban" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="ibanField" editable="false" styleClass="read-only-field"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="%label.accountName" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="accountNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="%label.accountHolder" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="accountHolderField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="%label.accountType" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="accountTypeCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="%label.currency" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="currencyField" editable="false" styleClass="read-only-field"
                                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label text="%label.comment" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextArea fx:id="accountCommentField" wrapText="true" prefRowCount="2"
                                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    </GridPane>
                    <CheckBox fx:id="syncExcludedCheckBox" id="syncExcludedCheckBox"
                              text="%label.skipBankSync"/>
                </VBox>

                <VBox styleClass="account-edit-metadata" spacing="5">
                    <HBox spacing="6">
                        <Label text="%label.balance" styleClass="secondary-text"/>
                        <Label fx:id="balanceValue" styleClass="secondary-text"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="%label.balanceDate" styleClass="secondary-text"/>
                        <Label fx:id="balanceDateValue" styleClass="secondary-text"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="%label.lastSync" styleClass="secondary-text"/>
                        <Label fx:id="lastSyncValue" styleClass="secondary-text"/>
                    </HBox>
                </VBox>
                </VBox>
            </content>
        </ScrollPane>
        <VBox fx:id="accountSelectionPage" visible="false" managed="false" spacing="12" prefHeight="520">
            <Label text="%dialog.bankAccounts.title" styleClass="section-title"/>
            <Label text="%dialog.bankAccounts.subtitle" wrapText="true" styleClass="help-text"/>
            <VBox fx:id="accountSelectionHost" VBox.vgrow="ALWAYS"/>
            <Label fx:id="accountImportStatusLabel" wrapText="true" styleClass="help-text"/>
        </VBox>
    </StackPane>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%button.cancel" onAction="#onCancel" styleClass="button-outlined"/>
        <Button fx:id="backButton" text="%button.back" onAction="#onBack"
                styleClass="button-outlined" visible="false" managed="false"/>
        <Button fx:id="saveButton" id="saveAccountButton" text="%button.save"
                onAction="#onSave" styleClass="button-outlined">
            <graphic><FontIcon iconLiteral="fth-save" iconSize="14"/></graphic>
        </Button>
        <Button fx:id="testConnectionButton" text="%button.connect"
                onAction="#onPrimaryAction" styleClass="accent-button"/>
    </HBox>
</VBox>
