<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.fintrax.ui.controller.RulesController">
    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%view.rules" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="%button.addRule" onAction="#onAddRule" styleClass="accent-button"/>
                <Button text="%button.moveUp" onAction="#onMoveUp"/>
                <Button text="%button.moveDown" onAction="#onMoveDown"/>
                <Button text="%button.toggle" onAction="#onToggleEnabled"/>
                <Button text="%button.applyAll" onAction="#onApplyAll"/>
            </HBox>
            <Label text="%subtitle.rules"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.35">
            <ListView fx:id="ruleList"/>
            <VBox spacing="10">
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%label.ruleName" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="ruleNameField" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Separator/>
                <Label text="%label.conditions" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true" prefHeight="150">
                    <VBox fx:id="conditionsContainer" spacing="5">
                        <padding>
                            <Insets top="5" right="5" bottom="5" left="5"/>
                        </padding>
                    </VBox>
                </ScrollPane>
                <Button text="%button.addCondition" onAction="#onAddCondition"/>
                <Separator/>
                <Label text="%label.actions" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true" prefHeight="120">
                    <VBox fx:id="actionsContainer" spacing="5">
                        <padding>
                            <Insets top="5" right="5" bottom="5" left="5"/>
                        </padding>
                    </VBox>
                </ScrollPane>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="%button.addAction" onAction="#onAddAction"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="previewButton" text="%button.preview" onAction="#onPreview" disable="true"/>
                    <Label fx:id="matchCountLabel" style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                </HBox>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="deleteButton" text="%button.delete" onAction="#onDelete" disable="true" styleClass="delete-button"/>
                    <Button fx:id="saveButton" text="%button.save" onAction="#onSave" disable="true" styleClass="accent-button"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
