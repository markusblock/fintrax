<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.fintrax.ui.controller.TransactionsController" styleClass="transactions-view">
    <top>
        <VBox styleClass="transactions-header">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%view.transactions" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="detailToggleButton" text="%button.toggleDetail" onAction="#onToggleDetail" styleClass="button-outlined">
                    <graphic><FontIcon iconLiteral="fth-eye" iconSize="15"/></graphic>
                </Button>
            </HBox>
            <fx:include fx:id="transactionFilterPanel" source="transactionFilterPanel.fxml"/>
        </VBox>
    </top>
    <center>
        <SplitPane fx:id="splitPane" orientation="VERTICAL" dividerPositions="1.0">
            <TableView fx:id="transactionTable" SplitPane.resizableWithParent="true">
                <columns>
                    <TableColumn fx:id="dateColumn" text="%col.date" minWidth="115" prefWidth="115" maxWidth="115"
                                 resizable="false"/>
                    <TableColumn fx:id="payeeColumn" text="%col.payee" minWidth="100" prefWidth="140"/>
                    <TableColumn fx:id="purposeColumn" text="%col.purpose" minWidth="120" prefWidth="180"/>
                    <TableColumn fx:id="amountColumn" text="%col.amount" minWidth="90" prefWidth="110"/>
                    <TableColumn fx:id="balanceColumn" text="%col.balance" minWidth="90" prefWidth="110"/>
                    <TableColumn fx:id="categoryColumn" text="%col.category" minWidth="90" prefWidth="130"/>
                    <TableColumn fx:id="labelsColumn" text="%col.labels" minWidth="90" prefWidth="130"/>
                    <TableColumn fx:id="columnMenuColumn" minWidth="17" prefWidth="17" maxWidth="17"
                                 resizable="false" sortable="false" reorderable="false">
                        <graphic>
                            <MenuButton fx:id="columnMenuButton" accessibleText="%button.columns"
                                        styleClass="column-menu-button"/>
                        </graphic>
                    </TableColumn>
                </columns>
            </TableView>
            <VBox fx:id="detailPanel" visible="false" managed="false" spacing="10"
                  styleClass="transaction-detail-panel">
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%detail.title" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="%button.close" onAction="#onToggleDetail" styleClass="button-outlined"/>
                </HBox>
                <GridPane fx:id="detailForm" hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                    </columnConstraints>
                    <Label text="%detail.payee" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="payeeField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="%detail.category" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Button fx:id="detailCategoryButton" maxWidth="Infinity" styleClass="button-outlined,assignment-picker-button"
                            GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="%detail.labels" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Button fx:id="detailLabelsButton" maxWidth="Infinity" styleClass="button-outlined,assignment-picker-button"
                            GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="%detail.note" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextArea fx:id="noteArea" prefRowCount="3" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="detailSaveButton" text="%button.save" onAction="#onSaveDetail"
                            styleClass="accent-button">
                        <graphic><FontIcon iconLiteral="fth-save" iconSize="15"/></graphic>
                    </Button>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
