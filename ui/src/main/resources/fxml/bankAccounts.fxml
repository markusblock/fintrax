<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.fintrax.ui.controller.BankAccountsController">
    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%view.bankAccounts" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addAccountButton" text="%button.addAccount" onAction="#onAddAccount"
                        styleClass="accent-button"/>
                <Button fx:id="syncAllButton" text="%button.syncAll" onAction="#onSyncAll"/>
            </HBox>
            <Label fx:id="subtitleLabel" text="%subtitle.accounts"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <FlowPane fx:id="accountsPane" hgap="15" vgap="15" prefWrapLength="900">
                <padding>
                    <Insets top="10" right="20" bottom="10" left="20"/>
                </padding>
            </FlowPane>
        </ScrollPane>
    </center>
    <bottom>
        <VBox fx:id="syncStatusPane" spacing="5" styleClass="sync-status-pane">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%label.syncStatus" style="-fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="%button.clearLog" onAction="#onClearSyncLog" style="-fx-font-size: 11px;"/>
            </HBox>
            <ScrollPane fx:id="syncLogScroll" fitToWidth="true" prefHeight="120" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
                <VBox fx:id="syncLogContainer" spacing="3"/>
            </ScrollPane>
        </VBox>
    </bottom>
</BorderPane>
