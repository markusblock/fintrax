<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.fintrax.ui.controller.AddAccountDialogController"
      spacing="15" style="-fx-background-color: white;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="%dialog.addAccount.title" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="%dialog.addAccount.subtitle" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>

    <Separator/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="140" halignment="RIGHT"/>
            <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
        </columnConstraints>

        <Label text="%label.iban" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="ibanField" promptText="DE89 3704 0044 0532 0130 00"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="%label.bic" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="bicField" promptText="COBADEFFXXX"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%label.bankName" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="bankNameField"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="%label.accountHolder" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="accountHolderField"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="%label.accountType" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="accountTypeCombo" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="%label.pin" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <PasswordField fx:id="pinField"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="%label.comment" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="commentField"
                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%button.cancel" onAction="#onCancel"/>
        <Button fx:id="saveButton" text="%button.save" onAction="#onSave" styleClass="accent-button"/>
    </HBox>
</VBox>
