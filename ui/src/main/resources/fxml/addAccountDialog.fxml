<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.fintrax.ui.controller.AddAccountDialogController"
      styleClass="dialog-content">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="%dialog.addAccount.title" styleClass="dialog-title"/>
    <Label text="%dialog.addAccount.subtitle" styleClass="dialog-subtitle" wrapText="true"/>
    <Label fx:id="wizardStepLabel" text="%wizard.addAccount.bankStep" styleClass="secondary-text"/>

    <StackPane fx:id="wizardPageHost" VBox.vgrow="ALWAYS">
        <ScrollPane fx:id="connectionPage" fitToWidth="true" minHeight="0" prefViewportHeight="520"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="account-scroll">
            <content>
                <VBox spacing="14">
                    <VBox styleClass="editor-panel" spacing="10">
                        <Label text="%label.accountIdentity" styleClass="section-title"/>
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="140" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                            </columnConstraints>
                            <Label text="%label.iban" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="ibanField" promptText="DE89 3704 0044 0532 0130 00"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <VBox styleClass="editor-panel" spacing="10">
                        <Label text="%label.bankConnection" styleClass="section-title"/>
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="140" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                            </columnConstraints>
                            <Label text="%label.bankName" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="bankNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="%label.bicOptional" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="bicField" promptText="COBADEFFXXX"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="%label.blz" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="bankCodeField" editable="false" styleClass="read-only-field"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="%label.fintsUserId" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="fintsUserIdField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="%label.fintsCustomerId" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="fintsCustomerIdField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            <Label text="%label.passwordOptional" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <PasswordField fx:id="passwordField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                            <CheckBox fx:id="storePasswordCheckBox" text="%label.storePasswordForAccounts"
                                      GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                            <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="7" GridPane.columnIndex="1">
                                <TextField fx:id="fintsServerUrlField" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="findFinTsServerButton" text="%button.findFinTsServer"
                                        onAction="#onFindFinTsServer" styleClass="button-outlined"/>
                            </HBox>
                            <Label text="%label.fintsServerUrl" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                            <Label text="%label.bankComment" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                            <TextField fx:id="bankCommentField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                        </GridPane>
                        <Label fx:id="fintsServerStatusLabel" text="%message.fints.lookupHint"
                               wrapText="true" styleClass="help-text"/>
                        <Label text="%message.fints.pinStoredOnImport" wrapText="true" styleClass="help-text"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>

        <VBox fx:id="accountSelectionPage" visible="false" managed="false" spacing="12" prefHeight="520">
            <Label text="%dialog.bankAccounts.title" styleClass="section-title"/>
            <Label text="%dialog.bankAccounts.subtitle" wrapText="true" styleClass="help-text"/>
            <VBox fx:id="accountSelectionHost" VBox.vgrow="ALWAYS"/>
            <Label fx:id="accountImportStatusLabel" wrapText="true" styleClass="help-text"/>
        </VBox>
    </StackPane>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%button.cancel" onAction="#onCancel" styleClass="button-outlined"/>
        <Button fx:id="backButton" text="%button.back" onAction="#onBack"
                styleClass="button-outlined" visible="false" managed="false"/>
        <Button fx:id="saveButton" text="%button.saveBankDetails" onAction="#onSave" styleClass="button-outlined"/>
        <Button fx:id="testConnectionButton" text="%button.connect"
                onAction="#onPrimaryAction" styleClass="accent-button"/>
    </HBox>
</VBox>
