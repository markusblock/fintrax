<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.fintrax.ui.controller.SettingsController" styleClass="view-root">
    <top>
        <VBox styleClass="view-header">
            <Label text="%view.settings" styleClass="page-title"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="settings-scroll">
            <VBox styleClass="settings-content">
                <VBox styleClass="settings-card">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fth-sliders" iconSize="17"/>
                        <Label text="%settings.section.general" styleClass="section-heading"/>
                    </HBox>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="150" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                    </columnConstraints>
                    <Label text="%settings.language" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="languageCombo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="%settings.theme" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="themeCombo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>
                </VBox>

                <VBox styleClass="settings-card">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fth-database" iconSize="17"/>
                        <Label text="%settings.section.data" styleClass="section-heading"/>
                    </HBox>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="150" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="%settings.dataDir" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="dataDirLabel" styleClass="path-value"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                </GridPane>
                </VBox>

                <VBox styleClass="settings-card">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fth-key" iconSize="17"/>
                        <Label text="%settings.section.credentials" styleClass="section-heading"/>
                    </HBox>
                <TableView fx:id="credentialTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="accountColumn" text="%settings.credential.account" prefWidth="250"/>
                        <TableColumn fx:id="statusColumn" text="%settings.credential.status" prefWidth="150"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="%button.deleteCredential" onAction="#onDeleteCredential" styleClass="delete-button">
                        <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="14"/></graphic>
                    </Button>
                </HBox>
                </VBox>

                <VBox styleClass="settings-card">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fth-upload" iconSize="17"/>
                        <Label text="%settings.section.import" styleClass="section-heading"/>
                    </HBox>
                    <Label text="%settings.import.hibiscus.desc" wrapText="true" styleClass="help-text"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="%button.import" onAction="#onImportHibiscus" styleClass="accent-button">
                            <graphic><FontIcon iconLiteral="fth-upload" iconSize="14"/></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <VBox styleClass="settings-card">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fth-alert-triangle" iconSize="17"/>
                        <Label text="%settings.section.reset" styleClass="section-heading"/>
                    </HBox>
                    <Label text="%settings.reset.desc" wrapText="true" styleClass="help-text"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="%button.reset" onAction="#onResetData" styleClass="delete-button">
                            <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="14"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
