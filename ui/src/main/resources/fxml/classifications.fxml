<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.fintrax.ui.controller.ClassificationsController" styleClass="view-root">
    <top>
        <VBox styleClass="view-header">
            <Label text="%view.classifications" styleClass="page-title"/>
            <Label text="%subtitle.classifications" styleClass="view-subtitle"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.22" styleClass="content-split-pane">
            <VBox spacing="8">
                <StackPane>
                    <TextField fx:id="classificationSearchField" promptText="%classifications.search.prompt"
                               styleClass="rule-search-field"/>
                    <Button fx:id="classificationSearchClearButton" accessibleText="%classifications.search.clear"
                            onAction="#onClearClassificationSearch" styleClass="icon-button"
                            minWidth="28" prefWidth="28" minHeight="28" prefHeight="28"
                            visible="false" managed="false" StackPane.alignment="CENTER_RIGHT">
                        <graphic><FontIcon iconLiteral="fth-x" iconSize="14"/></graphic>
                        <tooltip><Tooltip text="%classifications.search.clear"/></tooltip>
                        <StackPane.margin><Insets right="3"/></StackPane.margin>
                    </Button>
                </StackPane>
                <TreeView fx:id="classificationTree" styleClass="category-tree" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox fx:id="categoryTransactionsPanel" spacing="12" styleClass="content-panel">
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>
                <Label text="%view.transactions" styleClass="section-heading"/>
                <fx:include fx:id="transactionFilterPanel" source="transactionFilterPanel.fxml"/>
                <TableView fx:id="classificationTransactionsTable" styleClass="dense" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="transactionDateColumn" text="%col.bookingDate" minWidth="105" prefWidth="105"
                                     maxWidth="105" resizable="false" sortable="true"/>
                        <TableColumn text="%col.valueDate" minWidth="105" prefWidth="105"
                                     maxWidth="105" resizable="false" sortable="true"/>
                        <TableColumn fx:id="transactionPayeeColumn" text="%col.payee" minWidth="85" prefWidth="115" sortable="true"/>
                        <TableColumn fx:id="transactionAccountColumn" text="%col.account" minWidth="90" prefWidth="120" sortable="true"/>
                        <TableColumn fx:id="transactionPurposeColumn" text="%col.purpose" minWidth="95" prefWidth="135" sortable="true"/>
                        <TableColumn fx:id="transactionAmountColumn" text="%col.amount" minWidth="80" prefWidth="95" sortable="true"/>
                        <TableColumn fx:id="transactionCategoryColumn" text="%col.category" minWidth="95" prefWidth="115" sortable="true"/>
                        <TableColumn fx:id="transactionLabelsColumn" text="%col.labels" minWidth="90" prefWidth="120" sortable="true"/>
                        <TableColumn minWidth="17" prefWidth="17" maxWidth="17"
                                     resizable="false" sortable="false" reorderable="false">
                            <graphic>
                                <MenuButton fx:id="columnMenuButton" accessibleText="%button.columns"
                                            styleClass="column-menu-button"/>
                            </graphic>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="classification-transactions-footer">
                    <Label text="%classifications.transactions.total" styleClass="secondary-text"/>
                    <Label fx:id="classificationTransactionsTotalAmount" styleClass="amount-positive"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
